<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Microsoft Store build of Leggimi.

  Identity values come from Partner Center (Product management > Product identity)
  and must match exactly. The Version attribute is overwritten by
  scripts/package-msix.ps1 from package.json, so bump the version there as usual.

  BackgroundColor is the mid-tone of the icon plate, sampled from
  src-tauri/icons/icon.png. It must never be "transparent": Windows then plates
  the logo on the system accent colour, which is where the blue taskbar square
  came from. The targetsize/altform-unplated variants in Assets\ (generated by
  scripts/gen-msix-assets.ps1) are what keeps the taskbar from plating at all.

  Resources lists the interface languages, which the Store page shows; en-US
  comes first, as the default. Simplified Chinese is zh-Hans-CN, the tag of the
  Partner Center listing (the Store accepts it as well as zh-CN).

  New > Markdown document in File Explorer: ShellNewFileName is an empty file
  that scripts/package-msix.ps1 stages in the package. Its name stays English
  in every language: an ms-resource name needs the strings in resources.pri,
  and the PRI that winapp generates indexes only the images.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap4="http://schemas.microsoft.com/appx/manifest/uap/windows10/4"
  xmlns:uap5="http://schemas.microsoft.com/appx/manifest/uap/windows10/5"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap4 uap5 rescap">

  <Identity
    Name="EnricoDeStefanis.Leggimi"
    Publisher="CN=F804373A-AA07-4DA7-BA0E-9AA7D32356D8"
    Version="1.8.1.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Leggimi</DisplayName>
    <PublisherDisplayName>Enrico De Stefanis</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>A fast Markdown viewer and editor for Windows.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
    <Resource Language="it-IT" />
    <Resource Language="de-DE" />
    <Resource Language="fr-FR" />
    <Resource Language="es-ES" />
    <Resource Language="zh-Hans-CN" />
  </Resources>

  <Applications>
    <Application Id="Leggimi" Executable="leggimi.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Leggimi"
        Description="A fast Markdown viewer and editor for Windows."
        BackgroundColor="#C06041"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Square71x71Logo="Assets\Square71x71Logo.png"
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="markdown">
            <uap:DisplayName>Markdown document</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType uap4:ShellNewFileName="ShellNew\New.md" uap4:ShellNewDisplayName="Markdown document">.md</uap:FileType>
              <uap:FileType>.markdown</uap:FileType>
              <uap:FileType>.mdown</uap:FileType>
              <uap:FileType>.mkd</uap:FileType>
              <uap:FileType>.mkdn</uap:FileType>
              <uap:FileType>.mdwn</uap:FileType>
              <uap:FileType>.markdn</uap:FileType>
              <uap:FileType>.mdtxt</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
        <!-- the leggimi command from any terminal (Settings > Apps > App execution aliases) -->
        <uap5:Extension Category="windows.appExecutionAlias" Executable="leggimi.exe" EntryPoint="Windows.FullTrustApplication">
          <uap5:AppExecutionAlias>
            <uap5:ExecutionAlias Alias="leggimi.exe" />
          </uap5:AppExecutionAlias>
        </uap5:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
