<?xml version="1.0" encoding="utf-8"?>
<!--
  MSIX manifest for the Microsoft Store build of Leggimi.

  Identity values come from Partner Center (Product management > Product identity)
  and must match exactly. The Version attribute is overwritten by
  scripts/package-msix.ps1 from package.json, so bump the version there as usual.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap rescap">

  <Identity
    Name="EnricoDeStefanis.Leggimi"
    Publisher="CN=F804373A-AA07-4DA7-BA0E-9AA7D32356D8"
    Version="1.8.1.0"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Leggimi</DisplayName>
    <PublisherDisplayName>Enrico De Stefanis</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <Description>A fast Markdown viewer and editor for Windows.</Description>
  </Properties>

  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Applications>
    <Application Id="Leggimi" Executable="leggimi.exe" EntryPoint="Windows.FullTrustApplication">
      <uap:VisualElements
        DisplayName="Leggimi"
        Description="A fast Markdown viewer and editor for Windows."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png">
        <uap:DefaultTile
          Square71x71Logo="Assets\Square71x71Logo.png"
          Wide310x150Logo="Assets\Wide310x150Logo.png"
          Square310x310Logo="Assets\Square310x310Logo.png" />
      </uap:VisualElements>
      <Extensions>
        <uap:Extension Category="windows.fileTypeAssociation">
          <uap:FileTypeAssociation Name="markdown">
            <uap:DisplayName>Markdown document</uap:DisplayName>
            <uap:Logo>Assets\Square44x44Logo.png</uap:Logo>
            <uap:SupportedFileTypes>
              <uap:FileType>.md</uap:FileType>
              <uap:FileType>.markdown</uap:FileType>
            </uap:SupportedFileTypes>
          </uap:FileTypeAssociation>
        </uap:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <rescap:Capability Name="runFullTrust" />
  </Capabilities>
</Package>
